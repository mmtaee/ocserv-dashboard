# Complete environment template. Keep this file synchronized with .env.sample.
SECRET_KEY="replace-with-a-random-secret"
AGENT_NODE=false
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD="replace-with-a-strong-superadmin-password"
ALLOW_ORIGINS="http://127.0.0.1:3000,https://127.0.0.1:3443"
CURRENT_RELEASE=""
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8080
SYSTEMD=false

POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="ocserv_db"
POSTGRES_USER="ocserv"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"
POSTGRES_SSLMODE="disable"
PGDATA="/var/lib/postgresql/18/docker"
INSTALL_POSTGRES=true
SYSTEMD_INSTALL_DIR="/opt/ocserv-dashboard"

OCSERV_PORT=443
OC_NET="172.16.24.0/24"
OCSERV_DNS="1.1.1.1"
OCSERV_BANNER="Welcome to the VPN service"
OCSERV_PRE_LOGIN_BANNER="Welcome"
SSL_CN="ocserv-dashboard"
SSL_ORG="ocserv-dashboard"
SSL_EXPIRE=3650
ETH=""
OCSERV_PRESERVE_CONFIG=false
OCSERV_REGENERATE_CONFIG=false

TELEGRAM_BOT_ENABLED=false
TELEGRAM_RECEIPTS_DIR=""
TELEGRAM_I18N_PATH=""
TELEGRAM_BOT_I18N_PATH=""
TELEGRAM_BOT_METADATA_LOCALES_PATH=""

GO_VERSION="1.26.0"
RUN_MIGRATIONS=true
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_SECONDS=2
POSTGRES_READY_MAX_ATTEMPTS=60
POSTGRES_READY_RETRY_SECONDS=1
DEBUG=0
OCSERV_DEBUG=999
