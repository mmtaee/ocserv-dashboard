# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.0

FROM golang:${GO_VERSION}-bookworm AS backend-builder

ENV CGO_ENABLED=0 \
    GOOS=linux

WORKDIR /src/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
RUN go build -trimpath -o /out/backend ./main.go

FROM postgres:18-trixie

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnutls-bin \
        iproute2 \
        iptables \
        ocserv \
        procps \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=backend-builder /out/backend /usr/local/bin/backend
COPY --chmod=755 docker/entrypoint.sh /usr/local/bin/container-entrypoint
COPY --chmod=755 docker/server.sh /usr/local/bin/container-server

ENV DEBUG=1 \
    SECRET_KEY=development-secret-key \
    JWT_SECRET=development-jwt-secret \
    ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173 \
    CURRENT_RELEASE=development \
    SYSTEMD=false \
    TELEGRAM_BOT_ENABLED=false \
    TELEGRAM_RECEIPTS_DIR=/opt/ocserv_dashboard/uploads/receipts \
    OCSERV_PORT=443 \
    OC_NET=172.16.24.0/24 \
    OCSERV_DNS=1.1.1.1 \
    SSL_CN=ocserv-dashboard-dev \
    SSL_ORG=ocserv-dashboard-dev \
    SSL_EXPIRE=3650 \
    OCSERV_PRESERVE_CONFIG=false \
    PGDATA=/var/lib/postgresql/18/docker \
    POSTGRES_HOST=127.0.0.1 \
    POSTGRES_PORT=5432 \
    POSTGRES_USER=ocserv \
    POSTGRES_PASSWORD=ocserv-development-password \
    POSTGRES_DB=ocserv_db \
    POSTGRES_SSLMODE=disable \
    POSTGRES_READY_MAX_ATTEMPTS=60 \
    POSTGRES_READY_RETRY_SECONDS=1 \
    RUN_MIGRATIONS=true \
    MIGRATION_MAX_ATTEMPTS=30 \
    MIGRATION_RETRY_SECONDS=2 \
    OCSERV_DEBUG=0

RUN mkdir -p \
        /app/cron_journal \
        /opt/ocserv_dashboard/uploads/receipts \
        /etc/ocserv/defaults \
        /etc/ocserv/groups \
        /etc/ocserv/users

EXPOSE 443/tcp 443/udp 5432/tcp 8080/tcp

VOLUME ["/var/lib/postgresql", "/etc/ocserv", "/app/cron_journal", "/opt/ocserv_dashboard/uploads/receipts"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD curl --fail --silent http://127.0.0.1:8080/health >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/container-entrypoint"]
CMD ["/usr/local/bin/container-server"]
