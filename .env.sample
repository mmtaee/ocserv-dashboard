# OCServ Dashboard environment
#
# Copy this file before installation:
#   cp .env.sample .env
#
# Native systemd installation:
#   sudo ./scripts/systemd/install.sh
#
# Docker runtime:
#   docker run --env-file .env ... ocserv-dashboard
#
# Keep values containing spaces or special characters inside double quotes.

# -----------------------------------------------------------------------------
# Backend security and HTTP
# -----------------------------------------------------------------------------

# Replace both placeholders with independent, random values, for example:
#   openssl rand -hex 32
SECRET_KEY="replace-with-a-random-secret"
JWT_SECRET="replace-with-a-random-jwt-secret"

# Comma-separated browser origins allowed by the API.
ALLOW_ORIGINS="http://127.0.0.1:3000,https://127.0.0.1:3443"

# Displayed by the release/status endpoint when set.
CURRENT_RELEASE=""

# Used by scripts/systemd/install.sh as backend serve flags.
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8080

# The systemd unit overrides this to true. Keep false for Docker.
SYSTEMD=false

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Systemd with INSTALL_POSTGRES=true: use 127.0.0.1.
# The all-in-one Docker image always overrides this to 127.0.0.1.
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="ocserv_db"
POSTGRES_USER="ocserv"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"
POSTGRES_SSLMODE="disable"

# PostgreSQL 18 Docker data directory. Mount the volume at /var/lib/postgresql,
# not the pre-18 /var/lib/postgresql/data path.
PGDATA="/var/lib/postgresql/18/docker"

# Systemd installer only. Set false when using an existing/external database.
INSTALL_POSTGRES=true

# Optional systemd installation destination.
SYSTEMD_INSTALL_DIR="/opt/ocserv-dashboard"

# -----------------------------------------------------------------------------
# OCServ configuration (Docker and systemd)
# -----------------------------------------------------------------------------

OCSERV_PORT=443
OC_NET="172.16.24.0/24"
OCSERV_DNS="1.1.1.1"
OCSERV_BANNER="Welcome to the VPN service"
OCSERV_PRE_LOGIN_BANNER="Welcome"

SSL_CN="ocserv-dashboard"
SSL_ORG="ocserv-dashboard"
SSL_EXPIRE=3650

# Leave empty to auto-detect the host's default outbound interface.
ETH=""

# Existing custom ocserv.conf handling:
# - false: replace an unmanaged/package default config with the dashboard config.
# - true: preserve an existing unmanaged config.
OCSERV_PRESERVE_CONFIG=false

# Force regeneration of ocserv.conf while preserving certificates and user data.
OCSERV_REGENERATE_CONFIG=false

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------

# Bot token and account settings are managed in the dashboard database.
TELEGRAM_BOT_ENABLED=false

# Native default: /opt/ocserv-dashboard/uploads/receipts
# Docker image default: /app/uploads/receipts
# Leave empty to let the selected runtime use its default.
TELEGRAM_RECEIPTS_DIR=""

# Optional localization overlays. Embedded translations are used when empty.
TELEGRAM_I18N_PATH=""
TELEGRAM_BOT_I18N_PATH=""
TELEGRAM_BOT_METADATA_LOCALES_PATH=""

# -----------------------------------------------------------------------------
# Docker startup only
# -----------------------------------------------------------------------------

# Optional Docker build argument:
#   docker build --build-arg GO_VERSION="${GO_VERSION}" -t ocserv-dashboard .
GO_VERSION="1.26.0"

# Run `backend migrate` before starting backend and OCServ.
RUN_MIGRATIONS=true
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_SECONDS=2

# Wait for the bundled PostgreSQL 18 server before running migrations.
POSTGRES_READY_MAX_ATTEMPTS=60
POSTGRES_READY_RETRY_SECONDS=1

# Enable backend debug mode and optional OCServ CLI debug level.
DEBUG=0
OCSERV_DEBUG=0
